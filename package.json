      "types": "./src/converse-code-bridge.mts",
      "import": "./src/converse-code-bridge.mts"
    }
  },
  "scripts": {
    "check": "node --check src/index.mts && node --check src/converse-code-bridge.mts",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
